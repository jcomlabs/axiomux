# Copy this file to .env and uncomment only the values you need.
# `.env` and `.env.*` are ignored; `.env.example` is the tracked template.

# Optional runtime selection. Keep OMP pinned to the audited omp/17.0.4 binary.
# OMP_BIN=C:\path\to\omp.exe
# SUPERAI_MODEL=openai-codex/gpt-5.6-sol
# SUPERAI_FALLBACK_MODELS=anthropic/claude-model,openrouter/model

# Native Neuralwatt override. `axiomux login neuralwatt` instead stores the key
# in the Windows DPAPI vault; an environment value takes precedence.
# NEURALWATT_API_KEY=replace-with-your-key

# Optional Browser Use adapter. Configure only one provider key; SUPERAI passes
# only the selected key to the disabled-by-default sidecar.
# BROWSER_USE_API_KEY=replace-with-your-key
# OPENAI_API_KEY=replace-with-your-key
# SUPERAI_BROWSER_MODEL=gpt-4.1-mini

# Optional Microsoft UFO adapter (experimental, native desktop control).
# SUPERAI_UFO_DIR=C:\path\to\reviewed\UFO
# SUPERAI_UFO_PYTHON=C:\path\to\python.exe
